# Docker / local demo: copy this file to .env and add your own OpenRouter key.
#
#   cp .env.example .env
#
# One key for everything that talks to a model: the KI-Tutor chat, the hints and
# the teacher summary. It can live here or in backend-python/.env. Without it the
# app still starts, with built-in hints and the tutor's "not reachable" notice.
OPENROUTER_API_KEY=sk-or-...

# Optional: answer model used by the tutor.
CHAT_MODEL=google/gemma-4-31b-it

# The RAG service below is OPTIONAL and never sits in front of the chat: it only
# serves the textbook extras (figures, quiz/flashcard generators).
# `docker compose up app` runs the app alone; plain `docker compose up` brings
# the full stack.

# Optional: Hugging Face token for faster/rate-limit-free model downloads.
# HF_TOKEN=hf_...

# CPU-friendly defaults for Docker. Remove/raise them on a fast machine.
RAG_RERANK_CANDIDATES=8
RAG_IMAGE_RERANK=4
RAG_IMAGE_VLM_CHECK=0
RAG_CHAT_CACHE=256

# Optional host port overrides (defaults: 8000 / 8080).
# APP_PORT=8000
# RAG_PORT=8080
