# Docker / local demo: copy this file to .env and add your own OpenRouter key.
#
#   cp .env.example .env
#
# The KI-Tutor and the chemistry chat call OpenRouter directly from the app, so
# one key is enough to chat. The key can live here or in backend-python/.env.
# Without a key the app still starts, but the tutor answers
# "Der KI-Tutor ist gerade nicht erreichbar."
OPENROUTER_API_KEY=sk-or-...

# Optional: answer model used by the tutor.
CHAT_MODEL=google/gemma-4-31b-it

# The RAG service below is OPTIONAL: it only adds textbook sources and figures.
# `docker compose up app` runs the app alone; plain `docker compose up` brings
# the full stack. The app answers either way.

# Optional: Hugging Face token for faster/rate-limit-free model downloads.
# HF_TOKEN=hf_...

# CPU-friendly defaults for Docker. Remove/raise them on a fast machine.
RAG_RERANK_CANDIDATES=8
RAG_IMAGE_RERANK=4
RAG_IMAGE_VLM_CHECK=0
RAG_CHAT_CACHE=256

# Optional: enables the Claude-written hints/teacher summary in the app.
# ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_MODEL=claude-sonnet-5-5

# Optional host port overrides (defaults: 8000 / 8080).
# APP_PORT=8000
# RAG_PORT=8080
