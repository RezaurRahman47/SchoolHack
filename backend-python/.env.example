# Chat: the KI-Tutor and the chemistry chat call OpenRouter directly from the
# app, so this one key is all the tutor needs. Without it the chat still renders,
# but answers "Der KI-Tutor ist gerade nicht erreichbar."
OPENROUTER_API_KEY=sk-or-...

# Optional: answer model used by the tutor.
# CHAT_MODEL=google/gemma-4-31b-it

# Optional: the RAG service (separate server on :8080) adds textbook sources and
# figures to the chat. Leave it out and chat still works, just without sources.
# RAG_BASE=http://localhost:8080/api

# Optional: enables the Claude-written hints and the teacher summary
# (separate from the chat above).
# ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_MODEL=claude-sonnet-5-5
