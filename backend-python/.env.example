# Chat, hints and the teacher summary all use this one key (OpenRouter).
# Without it the app still runs: built-in hints and rule-based summaries.
OPENROUTER_API_KEY=sk-or-...

# Optional: answer model used by the tutor.
# CHAT_MODEL=google/gemma-4-31b-it

# Optional: only for the textbook extras (figures, quiz/flashcard generators).
# The chat itself never depends on the RAG server.
# RAG_BASE=http://localhost:8080/api
