# Copy to .env and put your own OpenRouter key in.
OPENROUTER_API_KEY=sk-or-...

# Fast no-reasoning answer model (measured ~1 s).
CHAT_MODEL=google/gemma-4-31b-it

# Optional vision model for captions / final image gate.
CAPTION_MODEL=google/gemma-4-31b-it
CAPTION_FALLBACK=mistralai/mistral-small-3.2-24b-instruct

# Demo tuning. On a cheap CPU VPS: 8 / 4 / 0
RAG_RERANK_CANDIDATES=16
RAG_IMAGE_RERANK=8
RAG_IMAGE_VLM_CHECK=1
RAG_CHAT_CACHE=256
